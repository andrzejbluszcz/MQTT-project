# Pliki do pominięcia w katalogu głównym
/*.json
/*.zip
/*.txt

# ==========================================
# Środowisko wirtualne (Virtual Environments)
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# Pamięć podręczna Pythona i kod bajtowy
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# ==========================================
# Konfiguracja edytora VSCode
# ==========================================
.vscode/*
# Pozwól Gitowi śledzić pliki konfiguracyjne projektu, jeśli pracujesz w zespole:
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
# Ignoruj pliki tymczasowe tworzone przez VSCode
.vscode/history/

# ==========================================
# Testy i analiza kodu (Linters/Formatters)
# ==========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ==========================================
# Pliki dystrybucyjne i budowanie pakietów
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Pliki środowiskowe i sekrety (BARDZO WAŻNE)
# ==========================================
.env
.env.*
*.env
secrets.json

# ==========================================
# Systemowe pliki tymczasowe
# ==========================================
.DS_Store
Thumbs.db
